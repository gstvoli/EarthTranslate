{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EarthTranslate",
  "version": "0.1.4",
  "identifier": "com.earthtranslate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EarthTranslate",
        "width": 990,
        "height": 640,
        "minWidth": 700,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://libretranslate.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGNjEyMzgyRDBGOEI2OEMKUldTTXR2alFnaU5oRDNaeSt6c0ttVVlRMkdMb1NENS9WZmpBUFJFT2FYcmNNSll3UXpUKzlQV3UK",
      "endpoints": [
        "https://github.com/gstvoli/EarthTranslate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
