{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EarthTranslate",
  "version": "0.1.0",
  "identifier": "com.earthtranslate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EarthTranslate",
        "width": 960,
        "height": 590,
        "minWidth": 680,
        "minHeight": 510,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://libretranslate.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
